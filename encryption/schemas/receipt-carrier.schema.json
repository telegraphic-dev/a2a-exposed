{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2a.exposed/ext/sealed/v1/receipt-carrier.schema.json",
  "description": "Receipt-only immutable null-response control carrier; no user-supplied text. Runtime compares exact receipt and outer bindings.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "message"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "contextId": {
          "type": "string",
          "pattern": "^[!-~]{1,200}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[!-~]{1,200}$"
        },
        "role": {
          "const": "agent"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "text"
              },
              "text": {
                "const": "[encrypted request accepted]"
              }
            },
            "required": [
              "kind",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "https://a2a.exposed/ext/sealed/v1"
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "https://a2a.exposed/ext/sealed/v1": {
              "type": "object",
              "properties": {
                "v": {
                  "const": 1
                },
                "assignment": {
                  "allOf": [
                    {
                      "$ref": "https://a2a.exposed/ext/sealed/v1/assignment.schema.json"
                    },
                    {
                      "properties": {
                        "responseDigest": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "v",
                "assignment"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "https://a2a.exposed/ext/sealed/v1"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "messageId",
        "contextId",
        "taskId",
        "role",
        "parts",
        "extensions",
        "metadata"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "contextId": {
          "type": "string",
          "pattern": "^[!-~]{1,200}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[!-~]{1,200}$"
        },
        "role": {
          "const": "ROLE_AGENT"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "const": "[encrypted request accepted]"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "https://a2a.exposed/ext/sealed/v1"
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "https://a2a.exposed/ext/sealed/v1": {
              "type": "object",
              "properties": {
                "v": {
                  "const": 1
                },
                "assignment": {
                  "allOf": [
                    {
                      "$ref": "https://a2a.exposed/ext/sealed/v1/assignment.schema.json"
                    },
                    {
                      "properties": {
                        "responseDigest": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "v",
                "assignment"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "https://a2a.exposed/ext/sealed/v1"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "messageId",
        "contextId",
        "taskId",
        "role",
        "parts",
        "extensions",
        "metadata"
      ],
      "additionalProperties": false
    }
  ]
}
