{
	"name": "a2a-exposed-worker",
	"private": true,
	"type": "module",
	"description": "Cloudflare Worker for a2a-exposed: public A2A endpoint, D1 database, wake webhooks, owner API",
	"license": "MIT",
	"scripts": {
		"build": "cf build",
		"deploy": "cf deploy",
		"pretest": "node scripts/stamp-version.mjs",
		"test": "node --import ./test/register-hooks.mjs --test test/*.test.ts",
		"test:coverage": "node scripts/stamp-version.mjs && node --import ./test/register-hooks.mjs --experimental-test-coverage --test-coverage-include=src/** --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=../coverage/worker.lcov --test test/*.test.ts",
		"typecheck": "cf workers types && tsc"
	},
	"engines": {
		"node": ">=22.18"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"cf": "^1.0.0-beta.13",
		"esbuild": "^0.28.2",
		"miniflare": "^5.20261006.0-alpha",
		"typescript": "^7.0.2",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"tunnelfetch": "1.13.0"
	}
}
