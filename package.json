{
	"name": "@a2a-exposed/control-core",
	"version": "0.8.24",
	"description": "A2A endpoint provisioning, routing, and D1 migrations for a2a-exposed.",
	"type": "module",
	"scripts": {
		"lint": "node scripts/check-repo.mjs lint",
		"format:check": "node scripts/check-repo.mjs format",
		"test:checks": "node --test scripts/*.test.mjs",
		"version:set": "node scripts/set-version.mjs",
		"prepare": "node control/scripts/build-core.mjs",
		"prepack": "node control/scripts/build-core.mjs"
	},
	"types": "./dist/types/control/src/core/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/control/src/core/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"control/migrations",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/telegraphic-dev/a2a-exposed.git"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
