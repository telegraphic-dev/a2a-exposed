# Deploy-time settings for a manual `cf deploy` (the CLI's `init`/`deploy` commands set these for you).
# Usage: cp deploy.env.example deploy.env && edit && set -a && . ./deploy.env && set +a && cf deploy
CLOUDFLARE_ACCOUNT_ID=
# Separate Cloudflare login? Add `--profile <name>` to the cf commands (CLI: --cf-profile <name>).
A2A_WORKER_NAME=a2a-exposed
A2A_HOSTNAME=agent.example.com     # leave empty to serve on <worker>.<account-subdomain>.workers.dev
# A2A_RETIRED_HOSTNAMES=             # old custom domains (comma-separated): card 301 -> PUBLIC_URL, else 410
# A2A_WORKERS_DEV_SUBDOMAIN=         # the account's workers.dev subdomain, so PUBLIC_URL can be set at deploy time
A2A_D1_ID=
# A2A_D1_NAME=a2a-exposed     # D1 database name (CLI: --d1-name; default: the worker name)
A2A_AGENT_NAME=My Agent
A2A_AGENT_DESCRIPTION=An AI agent reachable over A2A. Replies asynchronously.
# A2A_AGENT_SKILLS=[{"id":"general","name":"General requests","description":"...","tags":["assistant"]}]
# A2A_PROVIDER_ORGANIZATION=
# A2A_PROVIDER_URL=
WAKE_PRESET=generic
# WAKE_AGENT_ID=main
# WAKE_KEY_HEADER=authorization
# WAKE_KEY_PREFIX=Bearer 
# WAKE_BODY_TEMPLATE={"text":"{{summary}}"}
# Command shown in wake hints (CLI: --cli-command; default "npx -y a2a-exposed@latest"). For a source checkout:
# WAKE_CLI_COMMAND=node /path/to/a2a-exposed/cli/bin/a2a-exposed.mjs
# WAKE_DEBOUNCE_SECONDS=10
# WAKE_MAX_PER_HOUR=0
# A2A_ENABLE_CRON=1
# Proxy / expose mode (CLI: --upstream, --upstream-card-url): front an agent that already speaks A2A on a private
# network. The upstream must be reachable from Cloudflare: a Tunnel hostname behind Access, not a Tailnet/LAN URL.
# A2A_UPSTREAM_URL=https://agent-upstream.example.com/a2a
# A2A_UPSTREAM_CARD_URL=https://agent-upstream.example.com/.well-known/agent-card.json  # same origin as A2A_UPSTREAM_URL (credentials ride with the fetch)
# Secrets (OWNER_TOKEN, WAKE_WEBHOOK_URL, WAKE_WEBHOOK_KEY, WAKE_HMAC_SECRET, and for a wake URL behind
# Cloudflare Access WAKE_ACCESS_CLIENT_ID / WAKE_ACCESS_CLIENT_SECRET; in proxy mode UPSTREAM_TOKEN,
# UPSTREAM_ACCESS_CLIENT_ID / UPSTREAM_ACCESS_CLIENT_SECRET) go in a separate chmod-600
# file passed with `cf deploy --secrets-file <file>`; never commit them.
