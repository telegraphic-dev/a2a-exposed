{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2a.exposed/ext/sealed/v1/assigned-carrier.schema.json",
  "description": "Co-carried sealed response and non-null response-bound receipt. Runtime also compares all header bindings and the ciphertext digest before authentication.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "message"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[!-~]{1,200}$"
        },
        "contextId": {
          "type": "string",
          "pattern": "^[!-~]{1,200}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[!-~]{1,200}$"
        },
        "role": {
          "enum": [
            "user",
            "agent"
          ]
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "data"
              },
              "data": {
                "$ref": "https://a2a.exposed/ext/sealed/v1/envelope.schema.json",
                "properties": {
                  "header": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "message",
                          "status"
                        ]
                      }
                    }
                  }
                }
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "https://a2a.exposed/ext/sealed/v1": {
                    "type": "object",
                    "properties": {
                      "v": {
                        "const": 1
                      }
                    },
                    "required": [
                      "v"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "https://a2a.exposed/ext/sealed/v1"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "data",
              "metadata"
            ],
            "additionalProperties": false
          }
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "https://a2a.exposed/ext/sealed/v1"
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "https://a2a.exposed/ext/sealed/v1": {
              "type": "object",
              "properties": {
                "v": {
                  "const": 1
                },
                "assignment": {
                  "allOf": [
                    {
                      "$ref": "https://a2a.exposed/ext/sealed/v1/assignment.schema.json"
                    },
                    {
                      "properties": {
                        "responseDigest": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{43}$"
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "v",
                "assignment"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "https://a2a.exposed/ext/sealed/v1"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "messageId",
        "contextId",
        "role",
        "parts",
        "extensions",
        "metadata"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "pattern": "^[!-~]{1,200}$"
        },
        "contextId": {
          "type": "string",
          "pattern": "^[!-~]{1,200}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[!-~]{1,200}$"
        },
        "role": {
          "enum": [
            "ROLE_USER",
            "ROLE_AGENT"
          ]
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "https://a2a.exposed/ext/sealed/v1/envelope.schema.json",
                "properties": {
                  "header": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "message",
                          "status"
                        ]
                      }
                    }
                  }
                }
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "https://a2a.exposed/ext/sealed/v1": {
                    "type": "object",
                    "properties": {
                      "v": {
                        "const": 1
                      }
                    },
                    "required": [
                      "v"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "https://a2a.exposed/ext/sealed/v1"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "data",
              "metadata"
            ],
            "additionalProperties": false
          }
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "https://a2a.exposed/ext/sealed/v1"
          }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "https://a2a.exposed/ext/sealed/v1": {
              "type": "object",
              "properties": {
                "v": {
                  "const": 1
                },
                "assignment": {
                  "allOf": [
                    {
                      "$ref": "https://a2a.exposed/ext/sealed/v1/assignment.schema.json"
                    },
                    {
                      "properties": {
                        "responseDigest": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{43}$"
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "v",
                "assignment"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "https://a2a.exposed/ext/sealed/v1"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "messageId",
        "contextId",
        "role",
        "parts",
        "extensions",
        "metadata"
      ],
      "additionalProperties": false
    }
  ]
}
